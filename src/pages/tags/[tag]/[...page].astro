---
import { getCollection } from "astro:content";
import type { GetStaticPathsOptions } from "astro";
import Layout from "@/layouts/Layout.astro";
import BlogLayout from "@/components/BlogLayout.astro";
import Card from "@/components/Card.astro";
import Pagination from "@/components/Pagination.astro";
import { getUniqueTags } from "@/utils/getUniqueTags";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { slugifyAll } from "@/utils/slugify";
import { useTranslations } from "@/i18n";
import config from "@/config";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  const tags = getUniqueTags(posts);

  return tags.flatMap(({ tag, tagName }) => {
    const tagPosts = getSortedPosts(
      posts.filter(({ data }) => slugifyAll(data.tags).includes(tag))
    );

    return paginate(tagPosts, {
      params: { tag },
      props: { tagName },
      pageSize: config.posts.perPage,
    });
  });
}

const { page, tagName } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${t.pages.tagTitle}: ${tagName} | ${config.site.title}`}>
  <BlogLayout headings={[]} showToc={false} showRecent={false}>
    <main id="main-content" class="tag-content" data-pagefind-body>
      <h1 class="page-title">
        {t.pages.tagTitle}: {tagName}
      </h1>
      <p class="page-desc">
        {t.pages.tagDesc} "{tagName}".
      </p>

      <div class="posts-grid">
        {page.data.map(data => <Card {...data} />)}
      </div>

      <Pagination {page} />
    </main>
  </BlogLayout>
</Layout>

<style>
  .tag-content {
    max-width: 56rem;
    margin: 0 auto;
    padding: 0 1.5rem;
    width: 100%;
  }

  .page-title {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: var(--color-accent);
  }

  .page-desc {
    opacity: 0.7;
    margin-bottom: 2rem;
    font-style: italic;
  }

  .posts-grid {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
</style>
