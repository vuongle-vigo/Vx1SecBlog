---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import BlogLayout from "@/components/BlogLayout.astro";
import Card from "@/components/Card.astro";
import Pagination from "@/components/Pagination.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import {
  getPostCategorySlug,
  getUniqueCategories,
  UNCATEGORIZED_SLUG,
} from "@/utils/getCategories";
import config from "@/config";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  const sortedPosts = getSortedPosts(posts);

  // Categories come from the first folder level under src/content/posts,
  // e.g. posts/malware-analysis/<post>/post.md -> "malware-analysis".
  const categories = getUniqueCategories(sortedPosts);

  return categories.flatMap(({ slug, title }) => {
    const categoryPosts = sortedPosts.filter(
      post =>
        (getPostCategorySlug(post.filePath) ?? UNCATEGORIZED_SLUG) === slug
    );

    return paginate(categoryPosts, {
      params: { category: slug },
      props: { categoryTitle: title },
      pageSize: config.posts.perPage,
    });
  });
}) satisfies GetStaticPaths;

const { page, categoryTitle } = Astro.props;
---

<Layout title={`${categoryTitle} | ${config.site.title}`}>
  <BlogLayout headings={[]} showToc={false} showRecent={false}>
    <main id="main-content" class="category-content" data-pagefind-body>
      <h1 class="page-title">{categoryTitle}</h1>
      <p class="page-desc">
        {`${page.total} ${page.total === 1 ? "post" : "posts"}`}
      </p>

      <div class="posts-grid">
        {page.data.map(data => <Card {...data} />)}
      </div>

      <Pagination {page} />
    </main>
  </BlogLayout>
</Layout>

<style>
  .category-content {
    max-width: 56rem;
    margin: 0 auto;
    padding: 0 1.5rem;
    width: 100%;
  }

  .page-title {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: var(--color-accent);
  }

  .page-desc {
    opacity: 0.7;
    margin-bottom: 2rem;
    font-style: italic;
  }

  .posts-grid {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
</style>
